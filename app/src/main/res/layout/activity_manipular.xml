<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo2"
    android:orientation="vertical"
    tools:context=".Manipular">

    <TextView
        android:id="@+id/tvusumanipular"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:layout_marginTop="12dp"
        android:text="Nombre Usuario"
        android:textAlignment="center"
        android:textColor="#E60B0B"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Manipular Circuito"
        android:textAlignment="center"
        android:textColor="#156CF0"
        android:textSize="34sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnactivar"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:backgroundTint="#4CAF50"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Activar"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btndesactivar"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:backgroundTint="#A61F1F"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Desactivar"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnvolvman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#D71313"
        android:text="Volver"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>